<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:EposPosLinkExample.Helpers">

    <Color x:Key="LemonadeBrand">#E1E51A</Color>
    <Color x:Key="LemonadeBrandHigh">#46520F</Color>
    <Color x:Key="LemonadeBrandBorder">#C7CA16</Color>
    <Color x:Key="LemonadeBrandSubtle">#F6F7BA</Color>
    <Color x:Key="LemonadeContentBrand">#6D770D</Color>
    <Color x:Key="LemonadeContentOnBrand">#29320C</Color>
    <Color x:Key="LemonadeBgSubtle">#F6F5F3</Color>
    <Color x:Key="LemonadeBgElevated">#F7F6F5</Color>
    <Color x:Key="LemonadeBorderNeutralLow">#F1F0EE</Color>
    <Color x:Key="LemonadeBorderNeutralMedium">#E9E7E4</Color>
    <Color x:Key="LemonadeContentPrimary">#1B1B19</Color>
    <Color x:Key="LemonadeContentSecondary">#7F7E7A</Color>
    <Color x:Key="LemonadeContentCritical">#E41E2B</Color>
    <Color x:Key="LemonadeContentInfo">#1447E6</Color>

    <SolidColorBrush x:Key="LemonadeBrandBrush" Color="{StaticResource LemonadeBrand}" />
    <SolidColorBrush x:Key="LemonadeBrandBorderBrush" Color="{StaticResource LemonadeBrandBorder}" />
    <SolidColorBrush x:Key="LemonadeBrandSubtleBrush" Color="{StaticResource LemonadeBrandSubtle}" />
    <SolidColorBrush x:Key="LemonadeContentBrandBrush" Color="{StaticResource LemonadeContentBrand}" />
    <SolidColorBrush x:Key="LemonadeContentOnBrandBrush" Color="{StaticResource LemonadeContentOnBrand}" />
    <SolidColorBrush x:Key="LemonadeBgSubtleBrush" Color="{StaticResource LemonadeBgSubtle}" />
    <SolidColorBrush x:Key="LemonadeBgElevatedBrush" Color="{StaticResource LemonadeBgElevated}" />
    <SolidColorBrush x:Key="LemonadeBorderBrush" Color="{StaticResource LemonadeBorderNeutralMedium}" />
    <SolidColorBrush x:Key="LemonadeBorderNeutralMediumBrush" Color="{StaticResource LemonadeBorderNeutralMedium}" />
    <SolidColorBrush x:Key="LemonadeContentPrimaryBrush" Color="{StaticResource LemonadeContentPrimary}" />
    <SolidColorBrush x:Key="LemonadeContentSecondaryBrush" Color="{StaticResource LemonadeContentSecondary}" />
    <SolidColorBrush x:Key="LemonadeContentCriticalBrush" Color="{StaticResource LemonadeContentCritical}" />
    <SolidColorBrush x:Key="LemonadeContentInfoBrush" Color="{StaticResource LemonadeContentInfo}" />

    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource LemonadeBrand}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource LemonadeBrand}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource LemonadeBrandBorder}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource LemonadeContentOnBrand}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource LemonadeContentOnBrand}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource LemonadeContentBrand}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource LemonadeContentBrand}" />

    <Style x:Key="LemonadeTagBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <helpers:StatusToLabelConverter x:Key="StatusToLabel" />
    <helpers:StatusToBackgroundConverter x:Key="StatusToBackground" />
    <helpers:StatusToForegroundConverter x:Key="StatusToForeground" />
    <helpers:NullToVisibilityConverter x:Key="NullToVisibility" />
</ResourceDictionary>
