<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EposPosLinkExample.Views.PayAtTablePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:EposPosLinkExample.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!-- LIST STATE -->
        <Grid Visibility="{x:Bind ViewModel.IsListVisible, Mode=OneWay}" Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Pay at Table" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Background="Transparent" BorderThickness="0"
                        Command="{x:Bind ViewModel.RefreshTabsCommand}" ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                </Button>
            </Grid>

            <ToggleSwitch Grid.Row="1" Header="Pay at Table on store" Margin="0,12,0,0"
                          IsOn="{x:Bind ViewModel.PatEnabled, Mode=OneWay}"
                          Toggled="PatToggle_Toggled"/>

            <ScrollViewer Grid.Row="2" Margin="0,12,0,0">
                <GridView ItemsSource="{x:Bind ViewModel.Tiles}" SelectionMode="None"
                          IsItemClickEnabled="True" ItemClick="Tile_ItemClick">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid ItemWidth="170" Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="6"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:TableTile">
                            <Border Background="{ThemeResource LemonadeBgElevatedBrush}"
                                    BorderBrush="{ThemeResource LemonadeBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" MinHeight="150">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="{x:Bind TotalFormatted, Mode=OneWay}"
                                               Foreground="{ThemeResource LemonadeContentBrandBrush}"/>
                                    <Border Style="{StaticResource LemonadeTagBorderStyle}"
                                            Background="{Binding Status, Converter={StaticResource StatusToBackground}}">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusToLabel}}"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToForeground}}"/>
                                    </Border>
                                    <Border Style="{StaticResource LemonadeTagBorderStyle}"
                                            Background="{ThemeResource LemonadeBrandSubtleBrush}"
                                            Visibility="{x:Bind BillTagVisibility, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind BillTagText, Mode=OneWay}"
                                                   Foreground="{ThemeResource LemonadeContentInfoBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </ScrollViewer>

            <Button Grid.Row="3" Content="Add table" Margin="0,12,0,0" HorizontalAlignment="Right"
                    Style="{StaticResource AccentButtonStyle}" Click="AddTable_Click"
                    IsEnabled="{x:Bind ViewModel.IsSdkReady, Mode=OneWay}"/>
        </Grid>

        <!-- DETAILS STATE -->
        <Grid Visibility="{x:Bind ViewModel.IsTableSelected, Mode=OneWay}" Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Background="Transparent" BorderThickness="0"
                        Command="{x:Bind ViewModel.CloseTableDetailsCommand}">
                    <FontIcon Glyph="&#xE72B;" FontSize="16"/>
                </Button>
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedTabName, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <Border Grid.Column="2" Style="{StaticResource LemonadeTagBorderStyle}"
                        Background="{x:Bind ViewModel.SelectedTabStatus, Mode=OneWay, Converter={StaticResource StatusToBackground}}">
                    <TextBlock Text="{x:Bind ViewModel.SelectedTabStatus, Mode=OneWay, Converter={StaticResource StatusToLabel}}"
                               Foreground="{x:Bind ViewModel.SelectedTabStatus, Mode=OneWay, Converter={StaticResource StatusToForeground}}"/>
                </Border>
                <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Margin="8,0,0,0"
                        Command="{x:Bind ViewModel.RefreshSelectedTabDetailCommand}">
                    <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"
                        Visibility="{x:Bind ViewModel.SelectedShowingBillTerminalId, Mode=OneWay, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="Bill showing on terminal ID" Foreground="{ThemeResource LemonadeContentSecondaryBrush}" VerticalAlignment="Center"/>
                <Border Style="{StaticResource LemonadeTagBorderStyle}" Background="{ThemeResource LemonadeBrandSubtleBrush}">
                    <TextBlock Text="{x:Bind ViewModel.SelectedShowingBillTerminalId, Mode=OneWay}"
                               Foreground="{ThemeResource LemonadeContentInfoBrush}"/>
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="2" Margin="0,12,0,0">
                <StackPanel Spacing="4">
                    <TextBlock Text="Current items" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedTabItems, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:TabProductItem">
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind EmojiName}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                        <Button Content="&#x2212;" Command="{x:Bind RemoveCommand}"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{ThemeResource LemonadeContentBrandBrush}"/>
                                        <TextBlock Text="{x:Bind Quantity, Mode=OneWay}" VerticalAlignment="Center" MinWidth="20" TextAlignment="Center"/>
                                        <Button Content="+" Command="{x:Bind AddCommand}"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{ThemeResource LemonadeContentBrandBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind LineTotalFormatted, Mode=OneWay}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,12,0,0">
                <Button Content="Close table" Click="CloseTable_Click" Foreground="{ThemeResource LemonadeContentCriticalBrush}"/>
                <Button Content="Add items" Click="AddItems_Click" Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>

            <Border Grid.Row="4" Height="1" Background="{ThemeResource LemonadeBorderBrush}" Margin="0,12,0,0"/>

            <Grid Grid.Row="5" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.PaymentsCountText, Mode=OneWay}"
                           Foreground="{ThemeResource LemonadeContentSecondaryBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="View payments" Click="ViewPayments_Click"
                        Background="Transparent" BorderThickness="0"
                        Visibility="{x:Bind ViewModel.HasPayments, Mode=OneWay}"/>
            </Grid>

            <Grid Grid.Row="6" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Total" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedTabTotalFormatted, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource LemonadeContentBrandBrush}"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
