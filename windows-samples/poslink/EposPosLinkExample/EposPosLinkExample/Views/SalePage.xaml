<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EposPosLinkExample.Views.SalePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:EposPosLinkExample.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GridView Grid.Row="0"
                  ItemsSource="{x:Bind ViewModel.Products}"
                  SelectionMode="None"
                  Padding="12">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid ItemWidth="180" Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:ProductItem">
                    <Button Command="{x:Bind AddCommand}"
                            Padding="0" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Border Background="{ThemeResource LemonadeBgElevatedBrush}"
                                BorderBrush="{ThemeResource LemonadeBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12" MinHeight="160">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Emoji}" FontSize="24"/>
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="{x:Bind FormattedPrice}"
                                           Foreground="{ThemeResource LemonadeContentSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            Visibility="{x:Bind QuantityVisibility, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind QuantityText, Mode=OneWay}"
                                               Foreground="{ThemeResource LemonadeContentBrandBrush}"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <HyperlinkButton Content="Remove" Command="{x:Bind RemoveCommand}" Padding="4,2"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Button>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel Grid.Row="1" Padding="16"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.ItemCountText, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SubtotalText, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}"/>
            </Grid>
            <TextBox Header="Tip (£)" PlaceholderText="0.00" Margin="0,8,0,0"
                     DataContext="{x:Bind ViewModel}"
                     Text="{Binding TipInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     BeforeTextChanging="TipInput_BeforeTextChanging"/>
            <CheckBox Content="Unreferenced refund" Margin="0,8,0,0"
                      DataContext="{x:Bind ViewModel}"
                      IsChecked="{Binding UnreferencedRefund, Mode=TwoWay}"/>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Print" HorizontalAlignment="Stretch" Height="40"
                        Command="{x:Bind ViewModel.PrintReceiptCommand}"
                        IsEnabled="{x:Bind ViewModel.IsPayEnabled, Mode=OneWay}"/>
                <Button Grid.Column="2" Content="{x:Bind ViewModel.PayButtonText, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="40"
                        Command="{x:Bind ViewModel.PayCommand}"
                        IsEnabled="{x:Bind ViewModel.IsPayEnabled, Mode=OneWay}"/>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
