<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.eposposlinkexample.ui.sale.SaleController">

    <center>
        <ScrollPane fitToWidth="true">
            <FlowPane fx:id="productGrid" hgap="12" vgap="12" alignment="TOP_CENTER">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>
            </FlowPane>
        </ScrollPane>
    </center>

    <bottom>
        <VBox spacing="10" style="-fx-border-color: #dddbd7; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="itemCountLabel" text="0 items"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="subtotalLabel" text="Subtotal: £0.00"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Tip (£)"/>
                <TextField fx:id="tipField" promptText="0.00" prefWidth="120"/>
            </HBox>
            <CheckBox fx:id="unreferencedRefundToggle" text="Unreferenced refund"/>
            <HBox spacing="8">
                <Button fx:id="printButton" text="Print" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="payButton" text="Pay £0.00" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        style="-fx-base: #1447e6; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
